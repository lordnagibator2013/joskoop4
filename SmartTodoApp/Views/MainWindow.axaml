<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartTodoApp.Views.MainWindow"
        Title="реперская" Width="500" Height="600"
        Background="#f5f5f5">
    
    <StackPanel Margin="20" Spacing="15">
        <TextBlock Text="📝 Жоск дневник" 
                   FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        
        <Border Background="White" CornerRadius="8" Padding="15">
            <StackPanel Spacing="10">
                <TextBox x:Name="TaskInput" 
                         Watermark="Введите новую задачу..."
                         FontSize="14"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="➕ Добавить" 
                            Click="AddTask"
                            Background="#0078d4" 
                            Foreground="White"
                            Width="120"/>
                    
                    <Button Content="🗑️ Удалить выбранную" 
                            Click="DeleteTask"
                            Background="#d13438" 
                            Foreground="White"
                            Width="150"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <Border Background="White" CornerRadius="8" Padding="15">
            <ListBox x:Name="TasksList" Height="300">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}" 
                                  IsChecked="{Binding IsCompleted}"
                                  Margin="5" FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        
        <Border Background="White" CornerRadius="8" Padding="15">
            <StackPanel>
                <TextBlock Text="Сортировка:" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="📝 По названию" 
                            Click="SortByName"
                            Width="140"/>
                    <Button Content="✓ По статусу" 
                            Click="SortByStatus"
                            Width="140"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <TextBlock x:Name="StatsText" 
                   Text="Всего задач: 0 | Выполнено: 0"
                   HorizontalAlignment="Center"
                   FontSize="14" Foreground="#666"/>
    </StackPanel>
</Window>