<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:SmartTodoApp.Views"
        x:Class="SmartTodoApp.Views.MainWindow"
        Title="реперская" Width="400" Height="500">
    
    <StackPanel Margin="20">
        <TextBox x:Name="TaskInput" Watermark="Новая задача..."/>
        <Button Content="Добавить" Click="AddTask_Click" Margin="0,10,0,0"/>
        
        <ListBox x:Name="TasksList" Margin="0,20,0,0" Height="300">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding title}" 
                              IsChecked="{Binding isDone}"
                              Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</Window>