<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SmartTodoApp.Views.MainWindow"
        Title="реперская" Width="450" Height="550"
        Background="#f5f5f5">
    
    <StackPanel Margin="20" Spacing="10">
        <TextBlock Text="задач" 
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"/>
        
        <Border Background="White" CornerRadius="5" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="TaskInput" 
                         Watermark="Введите новую задачу..."
                         Width="300"/>
                         
                <Button Content="Добавить" 
                        Click="AddTask_Click"
                        Background="#0078d4" 
                        Foreground="White"/>

                <Button Content="🗑️ Удалить" 
                        Click="DeleteTask_Click"
                        Background="#d13438" 
                        Foreground="White"/>
            </StackPanel>
        </Border>
        
        <Border Background="White" CornerRadius="5" Padding="10">
            <ListBox x:Name="TasksList" Height="350">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Title}" 
                                  IsChecked="{Binding IsCompleted}"
                                  Margin="5" FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        
        <TextBlock x:Name="StatsText" 
                   Text="Задач: 0"
                   HorizontalAlignment="Center"
                   FontStyle="Italic" Foreground="#666"/>
    </StackPanel>
</Window>